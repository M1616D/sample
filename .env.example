# =============================================================================
# Industrial Platform — environment variables
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
# NEVER commit your real `.env` file. Only `.env.example` belongs in git.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local development uses SQLite (no server, no credentials, no cost).
# The file lives at prisma/dev.db and is created by `npm run db:push`.
DATABASE_URL="file:./dev.db"

# To use a free hosted Postgres (e.g. Supabase / Neon), switch the datasource
# provider in prisma/schema.prisma from "sqlite" to "postgresql" and set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# --- Authentication ---------------------------------------------------------
# Secret used to sign admin session cookies. REQUIRED in production.
# Generate a strong value with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# Initial administrator account, used only by `npm run db:seed`.
# Change the password immediately after the first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
SEED_ADMIN_NAME="Site Administrator"

# --- Site -------------------------------------------------------------------
# Canonical origin, used for SEO metadata, sitemap, QR codes and share links.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional: outbound Telegram notifications ------------------------------
# Leave BLANK to disable. When set, new quote requests are forwarded to the
# company's Telegram chat from the SERVER ONLY. Never expose these to the client.
# 1. Create a bot with @BotFather -> TELEGRAM_BOT_TOKEN
# 2. Message the bot, then read the chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
